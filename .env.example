# ========================================
# 🌙 MOONLIT STUDIOS - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env.local and fill in your actual API keys
# NEVER commit .env.local to git - it's protected by .gitignore

# ========================================
# 1. AI SERVICES ✅
# ========================================

# Anthropic Claude API - Powers AI Lab demos, advanced chatbot features
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here

# OpenAI API - Powers Kai chatbot, quote generation, voice AI (Whisper/TTS)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ========================================
# 2. EMAIL DELIVERY ✅
# ========================================

# Resend API - Primary email service (contact forms, Kai notifications, automated emails)
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here

# Business Email - Where all notifications are sent
BUSINESS_EMAIL=hello@moonlitstudios.com

# ========================================
# 3. CONSULTATION BOOKING ✅
# ========================================

# Calendly API - Discovery call scheduling, webhook integrations
# Get Personal Access Token at: https://calendly.com/integrations/api_webhooks
CALENDLY_API_TOKEN=your-calendly-personal-access-token-here
CALENDLY_USERNAME=your-calendly-username

# ========================================
# 4. DATABASE - SUPABASE (PostgreSQL) ✅
# ========================================

# Supabase Connection - Database for testimonials, quotes, form submissions
# Get keys at: https://app.supabase.com/project/_/settings/api

# Public Keys (Safe for Client-Side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (Server-Side Only - Keep Secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ========================================
# 5. CRM - NOTION API ✅
# ========================================

# Notion Integration API - CRM lead tracking + SOW document generation
# Create integration at: https://www.notion.so/my-integrations

# Notion API Key
NOTION_API_KEY=ntn_your-notion-integration-secret-here

# Notion CRM Database - Lead & contact management
# Get database ID from Notion URL: notion.so/workspace/DATABASE_ID?v=...
NOTION_CRM_DATABASE_ID=your-crm-database-id-here

# Notion SOW Database - Statement of Work document generator
NOTION_SOW_DATABASE_ID=your-sow-database-id-here

# ========================================
# 6. NOTIFICATIONS - SLACK WEBHOOKS ✅
# ========================================

# Slack Incoming Webhook - Instant notifications for new leads, quotes, contacts
# Create webhook at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ========================================
# 7. EMAIL (ALTERNATIVE) - BREVO (OPTIONAL)
# ========================================

# Brevo API - Alternative to Resend for higher email volume
# Free Tier: 9,000 emails/month
# Get your key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your-brevo-api-key-here

# ========================================
# 8. IMAGE STORAGE - CLOUDINARY (OPTIONAL)
# ========================================

# Cloudinary - Image/video upload, optimization, and transformation
# Get credentials at: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# ========================================
# 9. PAYMENTS - STRIPE ✅
# ========================================

# Stripe API - Payment processing, invoicing, subscriptions
# Get keys at: https://dashboard.stripe.com/apikeys

# Stripe Live Keys (Production)
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# For Testing, use Test Keys:
# STRIPE_SECRET_KEY=sk_test_your-test-key
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-test-key

# ========================================
# 10. ANALYTICS - PLAUSIBLE/UMAMI (OPTIONAL)
# ========================================

# Privacy-Focused Analytics - Alternative to Google Analytics
# Plausible: https://plausible.io
# Umami: https://umami.is
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=moonlitstudios.com
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id

# ========================================
# 11. AUTHENTICATION - NEXTAUTH (FUTURE)
# ========================================

# NextAuth - Admin panel security for /admin/testimonials
# Generate secret: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-string-here
ADMIN_PASSWORD=your-strong-admin-password

# ========================================
# 12. AI LAB USAGE LIMITS & DEMO MODE ✅
# ========================================

# AI Lab Rate Limits - Per IP address per 10 minutes
# Safe defaults to prevent abuse while allowing real demos
AI_LAB_VISION_LIMIT=5          # Computer vision demos (heavy - image analysis)
AI_LAB_VOICE_LIMIT=5           # Voice transcription (heavy - Whisper API)
AI_LAB_SALES_LIMIT=10          # Sales assistant chat (moderate - text only)
AI_LAB_RAG_LIMIT=15            # RAG Q&A system (light - cached responses)
AI_LAB_TRIAGE_LIMIT=10         # Healthcare triage (moderate - critical feature)

# Demo Mode Toggle - Use mocked responses instead of real AI
# Set to 'true' to save costs during low-traffic periods
# Set to 'false' (or leave unset) for real AI responses (default)
AI_LAB_DEMO_MODE=false

# ========================================
# 13. RATE LIMITING - UPSTASH REDIS (FUTURE)
# ========================================

# Upstash Redis - API rate limiting, spam prevention, caching
# Free Tier: 10,000 commands/day
# Get credentials at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ========================================
# 13. FORM CREATION - TALLY.SO (OPTIONAL)
# ========================================

# Tally Forms API - Alternative form builder/embedder
# Get API key at: https://tally.so/account/api-keys
TALLY_API_KEY=tly_your-tally-api-key-here

# ========================================
# 🌐 SITE CONFIGURATION
# ========================================

# Site URL - Used for email links, redirects, Stripe callbacks
# Development: http://localhost:3000
# Production: https://www.moonlitstudios.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ========================================
# 🛠️ SETUP INSTRUCTIONS
# ========================================
#
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in your actual API keys in .env.local
# 3. NEVER commit .env.local to git (it's in .gitignore)
# 4. Restart your dev server after changing env vars: npm run dev
#
# For Vercel Production:
# 1. Add ALL variables to: https://vercel.com/your-project/settings/environment-variables
# 2. Variables starting with NEXT_PUBLIC_ are exposed to browser
# 3. All other variables are server-side only (never exposed to client)
# 4. Redeploy after adding new environment variables
#
# ========================================

# ========================================
# ✅ MINIMUM REQUIRED TO RUN THE SITE:
# ========================================
# - OPENAI_API_KEY (Kai chatbot + quote generation)
# - RESEND_API_KEY (email notifications)
# - BUSINESS_EMAIL (notification recipient)
# - NEXT_PUBLIC_SITE_URL (links in emails)
#
# ========================================

# ========================================
# 💡 RECOMMENDED FOR FULL FUNCTIONALITY:
# ========================================
# - ANTHROPIC_API_KEY (AI Lab demos)
# - CALENDLY_API_TOKEN (booking integrations)
# - NEXT_PUBLIC_SUPABASE_URL (database)
# - NEXT_PUBLIC_SUPABASE_ANON_KEY (database)
# - SUPABASE_SERVICE_ROLE_KEY (database admin)
# - NOTION_API_KEY (CRM + SOW generator)
# - NOTION_CRM_DATABASE_ID (lead tracking)
# - NOTION_SOW_DATABASE_ID (contract generation)
# - SLACK_WEBHOOK_URL (instant notifications)
# - STRIPE_SECRET_KEY (payment processing)
#
# ========================================

