# 🌙 Moonlit Studios Environment Variables
# Copy this file to .env.local and fill in your actual API keys
# NEVER commit .env.local to git - it's protected by .gitignore

# ================================
# 🤖 AI SERVICES (REQUIRED FOR KAI)
# ================================

# OpenAI API Key - Powers Kai the AI chatbot
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ================================
# 📧 EMAIL SERVICES (REQUIRED)
# ================================

# Resend API Key - Sends emails for contact form, Kai notifications, etc.
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here

# Business email where notifications are sent
BUSINESS_EMAIL=hello@moonlitstudios.com

# ================================
# 🌐 SITE CONFIGURATION
# ================================

# Your site URL (used for email links and redirects)
# Development: http://localhost:3000
# Production: https://www.moonlitstudios.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ================================
# 💬 OPTIONAL INTEGRATIONS
# ================================

# Slack Webhook URL - Get notifications in Slack (optional)
# Get webhook at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Calendly URL - For calendar booking links (optional)
CALENDLY_URL=https://calendly.com/your-username

# ================================
# 💳 STRIPE (IF USING PAYMENTS)
# ================================

# Stripe API keys - For payment processing (optional)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ================================
# 🔐 AUTHENTICATION (IF USING CLIENT PORTAL)
# ================================

# NextAuth secret - For client portal authentication
NEXTAUTH_SECRET=your-random-secret-string-here
NEXTAUTH_URL=http://localhost:3000

# ================================
# 📊 ANALYTICS (OPTIONAL)
# ================================

# Google Analytics ID (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ================================
# 🛠️ SETUP INSTRUCTIONS
# ================================
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in your actual API keys in .env.local
# 3. NEVER commit .env.local to git
# 4. Restart your dev server after changing env vars

# ================================
# ✅ MINIMUM REQUIRED FOR KAI TO WORK:
# ================================
# - OPENAI_API_KEY (for Kai's brain)
# - RESEND_API_KEY (for email notifications)
# - BUSINESS_EMAIL (where to send notifications)
# - NEXT_PUBLIC_SITE_URL (for links in emails)
