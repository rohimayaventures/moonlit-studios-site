# ========================================
# MOONLIT STUDIOS - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git (it's in .gitignore)
# ========================================

# ----------------------------------------
# STRIPE (PAYMENTS) - TEST MODE
# ----------------------------------------
# Get these from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here

# Get this from: https://dashboard.stripe.com/test/webhooks
# Create a webhook endpoint pointing to: https://yourdomain.com/api/stripe/webhook
# Select events: checkout.session.completed, payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret_here

# ----------------------------------------
# SUPABASE (DATABASE)
# ----------------------------------------
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ----------------------------------------
# AI PROVIDERS
# ----------------------------------------
# Anthropic (Claude) - Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# OpenAI (Whisper, TTS, GPT) - Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key_here

# ----------------------------------------
# EMAIL
# ----------------------------------------
# Brevo (recommended - 9k emails/month free)
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here
BUSINESS_EMAIL=hello@moonlstudios.com

# Resend (alternative - 3k emails/month free)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_key_here

# ----------------------------------------
# INTEGRATIONS
# ----------------------------------------
# Notion CRM - Get from: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your_notion_key_here
NOTION_DATABASE_ID=your_database_id_here

# Slack Webhooks - Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Calendly - Get from: https://calendly.com/integrations/api_webhooks
CALENDLY_API_KEY=your_calendly_api_key_here
CALENDLY_WEBHOOK_SIGNING_KEY=your_calendly_webhook_key_here

# Cloudinary (Image Management) - Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Tally.so Forms - Get from: https://tally.so/help/api
# Free tier: Unlimited forms, API access for integrations
TALLY_API_KEY=your_tally_api_key_here

# ----------------------------------------
# SITE CONFIGURATION
# ----------------------------------------
# Your production domain (used for Stripe redirects and webhooks)
NEXT_PUBLIC_SITE_URL=https://moonlstudios.com

# ----------------------------------------
# SWITCHING TO LIVE MODE
# ----------------------------------------
# To go live with Stripe:
# 1. Get live keys from: https://dashboard.stripe.com/apikeys (switch to Live mode)
# 2. Replace STRIPE_SECRET_KEY with sk_live_...
# 3. Replace NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY with pk_live_...
# 4. Create LIVE webhook in Stripe Dashboard:
#    URL: https://moonlstudios.com/api/stripe/webhook
#    Events: checkout.session.completed, payment_intent.succeeded, payment_intent.payment_failed
#    Copy the webhook signing secret (whsec_live_...)
# 5. Update STRIPE_WEBHOOK_SECRET with the live webhook secret
# 6. Update NEXT_PUBLIC_SITE_URL to https://moonlstudios.com
# 7. Add ALL environment variables to Vercel Dashboard
# 8. Deploy and test with real payment (start with small amount!)
#
# CRITICAL FOR EMAILS:
# - Emails are sent via webhooks ONLY
# - You MUST create the webhook endpoint in Stripe Dashboard
# - Webhooks won't fire locally without Stripe CLI forwarding
# - In production, webhooks fire automatically when payments complete
# ========================================
