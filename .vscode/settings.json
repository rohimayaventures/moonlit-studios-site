{
  // Disable CSS linting warnings for Tailwind CSS directives
  "css.lint.unknownAtRules": "ignore",
  "css.lint.validProperties": [
    "mask-composite"
  ],

  // Tailwind CSS IntelliSense
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],

  // Editor settings for better Tailwind experience
  "editor.quickSuggestions": {
    "strings": true
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },

  // Disable other CSS warnings that may conflict with Tailwind
  "css.validate": true,
  "scss.validate": true,
  "less.validate": true
}
